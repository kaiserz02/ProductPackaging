WITH PackagingHierarchy AS (
    SELECT 
        p.PackageId,
        p.ProductId,
        p.PackageTypeId,
        pt.PackageTypeName,
        p.ParentPackageId,
        0 AS Level
    FROM Packaging p
    JOIN PackagingTypes pt ON p.PackageTypeId = pt.PackageTypeId
    WHERE p.ParentPackageId IS NULL

    UNION ALL

    SELECT 
        c.PackageId,
        c.ProductId,
        c.PackageTypeId,
        pt.PackageTypeName,
        c.ParentPackageId,
        ph.Level + 1
    FROM Packaging c
    JOIN PackagingHierarchy ph ON c.ParentPackageId = ph.PackageId
    JOIN PackagingTypes pt ON c.PackageTypeId = pt.PackageTypeId
)
SELECT *
FROM PackagingHierarchy
ORDER BY Level, PackageId;
